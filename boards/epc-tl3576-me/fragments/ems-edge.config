# Delta over rockchip_linux_defconfig + rockchip_linux_docker.config.
# Every line here exists because the vendor's shipped kernel lacked it and this
# platform needs it. Verified absent in the extracted shipped config.

# Verified boot and A/B integrity. BLK_DEV_DM is off in the vendor build, which
# forecloses dm-verity entirely; enabling DM now means verified boot is a later
# config change rather than a later kernel project.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y

# The vendor build has no LSM framework at all — CONFIG_SECURITY is unset, so
# its CONFIG_LSM= string is inert. The rootfs is Ubuntu-derived and its Docker
# packaging assumes AppArmor; without this every container runs unconfined.
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y

# Commercial sites routinely put building management on a tagged VLAN.
CONFIG_VLAN_8021Q=y

# Per-container write throttling. This board has an eMMC endurance budget and a
# field life measured in years; unbounded container writes are a wear problem.
CONFIG_BLK_DEV_THROTTLING=y

# Our own initramfs, not the vendor's.
#
# The vendor defconfig sets CONFIG_INITRAMFS_SOURCE="$(RK_SDK_DIR)/tools/linux/
# ramdisk", so the kernel is only buildable from inside the full Rockchip SDK
# with RK_SDK_DIR exported. Unset, it expands to "/tools/linux/ramdisk" and the
# build fails in usr/gen_initramfs.sh.
#
# That ramdisk is 806 files of Ubuntu-derived early userspace -- apt config,
# adduser.conf, alternatives symlinks. Shipping it into every unit would mean
# inheriting a userspace we did not choose, on a kernel we are building
# specifically to add AppArmor and dm-verity. Empty for now; when dm-verity
# needs early userspace to set up the verity device, we build a minimal one and
# point this at it.
#
# UNVERIFIED: whether the board boots without the vendor ramdisk. Their boot.img
# is a FIT bundling kernel, DTB and ramdisk, and their boot flow may depend on
# it. Closes on a bench unit, which is re-flashable over maskrom.
CONFIG_INITRAMFS_SOURCE=""
